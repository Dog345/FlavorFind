<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme — windowBackground matches our dark scaffold -->
    <style name="Theme.FlavorFind" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:statusBarColor">#FF121212</item>
        <item name="android:navigationBarColor">#FF121212</item>
    </style>

    <!-- Splash screen theme using androidx core-splashscreen -->
    <style name="Theme.FlavorFind.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF121212</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.FlavorFind</item>
    </style>
</resources>
