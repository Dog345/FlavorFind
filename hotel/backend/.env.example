APP_NAME=HotelManager
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.hotel.flavorfind.co.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ─── Primary Database (PostgreSQL — hotel schema) ───────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hotel
DB_USERNAME=hotel_user
DB_PASSWORD=

# ─── Secondary Read-Only Database (FlavorFind recipes) ──────────────────────
# This connection is read-only — never run migrations against it.
DB_FLAVORFIND_HOST=127.0.0.1
DB_FLAVORFIND_PORT=5432
DB_FLAVORFIND_DATABASE=flavorfind
DB_FLAVORFIND_USERNAME=flavorfind_readonly
DB_FLAVORFIND_PASSWORD=

# ─── Cache / Session / Queue ────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# ─── Laravel Reverb (WebSockets) ────────────────────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── M-Pesa / Daraja ────────────────────────────────────────────────────────
# env: 'sandbox' for testing, 'production' for live
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# Must be publicly accessible — use ngrok in local dev: https://<id>.ngrok.io/api/v1/payments/mpesa/callback
MPESA_CALLBACK_URL=https://api.hotel.flavorfind.co.ke/api/v1/payments/mpesa/callback

# ─── Testing ─────────────────────────────────────────────────────────────────
# Copy to .env.testing and uncomment to run PHPUnit against SQLite in-memory.
# Tests mock all external HTTP calls (Daraja) via Http::fake() — no real keys needed.
#
# APP_ENV=testing
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:
# CACHE_STORE=array
# QUEUE_CONNECTION=sync
# SESSION_DRIVER=array
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=test_key
# MPESA_CONSUMER_SECRET=test_secret
# MPESA_PASSKEY=test_passkey
# MPESA_SHORTCODE=174379
# MPESA_CALLBACK_URL=https://example.com/api/v1/payments/mpesa/callback

# ─── Mail ───────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@hotel.flavorfind.co.ke
MAIL_FROM_NAME="${APP_NAME}"

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ─── Filesystem ─────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
