APP_NAME=FlavorFind
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flavorfind
DB_USERNAME=root
DB_PASSWORD=

# Spoonacular API Keys (add up to 15)
SPOONACULAR_KEY_1=your_key_1_here
SPOONACULAR_KEY_2=your_key_2_here
SPOONACULAR_KEY_3=your_key_3_here
SPOONACULAR_KEY_4=your_key_4_here
SPOONACULAR_KEY_5=your_key_5_here
SPOONACULAR_KEY_6=your_key_6_here
SPOONACULAR_KEY_7=your_key_7_here
SPOONACULAR_KEY_8=your_key_8_here
SPOONACULAR_KEY_9=your_key_9_here
SPOONACULAR_KEY_10=your_key_10_here
SPOONACULAR_KEY_11=your_key_11_here
SPOONACULAR_KEY_12=your_key_12_here
SPOONACULAR_KEY_13=your_key_13_here
SPOONACULAR_KEY_14=your_key_14_here
SPOONACULAR_KEY_15=your_key_15_here

# Daily request limit per key (Spoonacular free = 150/day)
SPOONACULAR_DAILY_LIMIT=150

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
